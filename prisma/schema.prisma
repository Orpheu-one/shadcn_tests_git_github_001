datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OPERATOR
  ADMIN
  D2D
  SUPERVISOR
}

enum EventType {
  SALE
  CALLBACK
}

enum EventChannel {
  REMOTE
  F2F
}

enum EventStatus {
  PROJECT
  CLOSED
  LOST
}

model User {
  id         Int      @id @default(autoincrement())
  userId     String   @unique // Este é o ID do Clerk
  internalId String   @unique @db.VarChar(4) // O teu ID de 4 letras (ex: JOSE)
  email      String   @unique
  frst_name  String
  lst_name   String
  phone      String?
  avatar     String?
  desc       String?
  role       UserRole  @default(OPERATOR)
  is_active  Boolean   @default(true)
  created_at DateTime @default(now())
  events     Event[]

  @@index([internalId])
}

model Client {
  id        Int      @id @default(autoincrement())
  frst_name String
  lst_name  String?
  phone     String   @unique
  email     String?  @unique
  address   String
  lat       Float?
  long      Float?
  event     Event?

  @@index([phone])
}

model Event {
  id           Int        @id @default(autoincrement())
  event_id     String     @unique 
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  clientId     Int        @unique 
  client       Client     @relation(fields: [clientId], references: [id])
  type         EventType    @default(SALE)
  channel      EventChannel @default(REMOTE)
  status       EventStatus  @default(PROJECT)
  obs          String?      @db.Text
  Scheduled    DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  calledback_at DateTime?

  @@index([status])
}